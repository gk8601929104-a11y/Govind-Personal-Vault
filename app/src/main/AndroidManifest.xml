<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LockActivity" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="false" />
        <activity android:name=".RecoveryActivity" android:exported="false" />
        <activity android:name=".VaultActivity" android:exported="false" />
        <activity android:name=".EntryEditorActivity" android:exported="false" />
        <activity android:name=".DeleteConfirmActivity" android:exported="false" />
        <activity android:name=".MediaVaultActivity" android:exported="false" />
        <activity android:name=".MediaDeleteConfirmActivity" android:exported="false" />
        <activity android:name=".DocumentsVaultActivity" android:exported="false" />
        <activity android:name=".SecureImageViewerActivity" android:exported="false" />
        <activity android:name=".SecureMediaPlayerActivity" android:exported="false" />
        <activity android:name=".SecureDocumentActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />

    </application>
</manifest>
